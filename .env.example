# .env.example — Copy to .env and set values. NEVER commit .env
#   cp .env.example .env

# Postgres (required for docker compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=market_intel
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://admin:your_postgres_password@localhost:5433/market_intel

# Neo4j (required for docker compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Redis (agent_cache)
REDIS_URL=redis://localhost:6379/0

# LLM APIs (for agent workflow)
GOOGLE_API_KEY=your_gemini_key
GOOGLE_API_KEY_FALLBACK=your_gemini_fallback_key
GROQ_API_KEY=your_groq_key

# Gemini API (for agent LLM)
GOOGLE_API_KEY=your_google_api_key_here
