# .env.example — Copy to .env and set values. NEVER commit .env
#   cp .env.example .env

# Postgres (required for docker compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=market_intel
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://admin:your_postgres_password@localhost:5433/market_intel

# Neo4j (required for docker compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Redis (agent_cache)
REDIS_URL=redis://localhost:6379/0

# LLM APIs (agent workflow; set at least one primary path via model.yaml chain)
GOOGLE_API_KEY=your_google_or_gemini_api_key
GOOGLE_API_KEY_FALLBACK=your_optional_fallback_key
GROQ_API_KEY=your_groq_key

# Human-in-the-loop (optional): pause after diversity_gate; resume with MCP resume_research(thread_id, lambda_value).
# Requires AMI_HITL_DIVERSITY=1. Threshold = max(context blocks, len(retrieved_ids), count of "GRAPH FACT:" lines); default in code is 3.
# AMI_HITL_DIVERSITY=0
# AMI_HITL_MIN_CONTEXT=3
# Lower (e.g. 1) if you want HITL even on sparse retrieval.
